{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://downloads.wordpress.org/release/wordpress-7.1.3.zip",
  "phpVersion": "8.4",
  "mariadbVersion": "11.8",
  "plugins": [
    "./wp-content/plugins/arn-intranet-core"
  ],
  "themes": [
    "./wp-content/themes/arn-intranet"
  ],
  "port": 8888,
  "testsEnvironment": false,
  "phpmyadmin": false,
  "config": {
    "WP_ENVIRONMENT_TYPE": "local",
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "DISALLOW_FILE_EDIT": true,
    "ARN_ALLOW_FICTIONAL_LOCAL_ACCESS": true
  },
  "mappings": {
    "arn-repo": "."
  },
  "lifecycleScripts": {
    "afterStart": "node scripts/bootstrap-env.mjs"
  }
}
