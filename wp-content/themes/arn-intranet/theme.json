{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "44rem",
      "wideSize": "76rem"
    },
    "color": {
      "palette": [
        {
          "slug": "base",
          "name": "Fundo",
          "color": "#f4f7f8"
        },
        {
          "slug": "surface",
          "name": "Superfície",
          "color": "#ffffff"
        },
        {
          "slug": "ink",
          "name": "Texto",
          "color": "#1b242c"
        },
        {
          "slug": "primary",
          "name": "Azul institucional",
          "color": "#0b3a5b"
        },
        {
          "slug": "accent",
          "name": "Verde de acento",
          "color": "#1f6b4a"
        },
        {
          "slug": "muted",
          "name": "Texto secundário",
          "color": "#526373"
        },
        {
          "slug": "border",
          "name": "Linha",
          "color": "#d8e1e7"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Source Sans 3",
          "fontFamily": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Source Sans 3",
              "fontStyle": "normal",
              "fontWeight": "200 900",
              "src": [
                "file:./assets/fonts/SourceSans3.ttf"
              ]
            }
          ]
        },
        {
          "slug": "heading",
          "name": "Manrope",
          "fontFamily": "Manrope, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "src": [
                "file:./assets/fonts/Manrope.ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "caption",
          "name": "Auxiliar",
          "size": "0.875rem"
        },
        {
          "slug": "body",
          "name": "Corpo",
          "size": "1.0625rem"
        },
        {
          "slug": "subheading",
          "name": "Subtítulo",
          "size": "1.25rem"
        },
        {
          "slug": "section",
          "name": "Secção",
          "size": "1.5rem"
        },
        {
          "slug": "heading",
          "name": "Título",
          "size": "1.875rem"
        },
        {
          "slug": "display",
          "name": "Título de página",
          "size": "2.25rem"
        }
      ],
      "fluid": false
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1.0625rem",
      "lineHeight": "1.6",
      "fontWeight": "400"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--section)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--subheading)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--subheading)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--surface)"
        },
        "border": {
          "radius": "0.375rem"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--body)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--subheading)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--caption)",
          "lineHeight": "1.5"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body)",
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Cabeçalho",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Rodapé",
      "area": "footer"
    }
  ]
}
