{
  "name": "arn/intranet",
  "description": "Dependências PHP de desenvolvimento da plataforma interna da ARN.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "11.5.57",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "autoload": {
    "psr-4": {
      "Arn\\Intranet\\": "wp-content/plugins/arn-intranet-core/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.4.0"
    },
    "preferred-install": "dist",
    "sort-packages": true
  }
}
